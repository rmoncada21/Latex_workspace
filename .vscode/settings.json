{
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-aux-build",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-emulate-aux-dir",
        "-auxdir=build",
        "-outdir=.",
        "%DOC%"
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "PDF en raiz, aux en build",
      "tools": ["latexmk-aux-build"]
    }
  ],
  "latex-workshop.view.outline.sections": [
    "part", "chapter", "section", "subsection",
    "subsubsection", "paragraph|subsubsubsection"
  ],
  "latex-workshop.intellisense.command.user": {
    "subsubsubsection{}": "subsubsubsection{$1}",
    "subsubsubsection[]{}": "subsubsubsection[${2:corto}]{$1}",
    "subsubsubsection*{}": "subsubsubsection*{$1}"
  },
  "latex-workshop.latex.verbatimEnvs": [
    "verbatim", "Verbatim", "BVerbatim", "LVerbatim", "SaveVerbatim", "VerbatimOut",
    "lstlisting", "minted", "comment", "alltt", "listing",
    "codigoC", "codigoSV", "codigoBash", "codigoClat",
    "codigoCterm", "codigoCterm2", "codigoCtermlnx",
    "codigoCtab", "codigoCieee",
    "codigoCmin", "codigoCcap", "codigoSVcap", "codigoBashcap",
    "codeBlockC", "codeBlockC", "codeBlockSV", "codeBlockBash", "codeBlockLat",
    "codeBlockTab", "codeBlockIeee", "codeBlockTermROG", "codeBlockTermGGG",
    "codeBlockTermLinux", "codeBlockMinC", "codeBlockMinCcap",
    "codeBlockMinSVcap", "codeBlockMinBashcap"
  ],
  "latex-workshop.view.pdf.viewer": "external",
  "latex-workshop.view.pdf.external.viewer.command": "okular",
  "latex-workshop.view.pdf.external.viewer.args": [
    "--unique",
    "%PDF%"
  ],
  "latex-workshop.view.pdf.external.synctex.command": "okular",
  "latex-workshop.view.pdf.external.synctex.args": [
    "--unique",
    "%PDF%#src:%LINE%%TEX%"
  ],
  "latex-workshop.synctex.afterBuild.enabled": true,
  "[latex]": {
    "editor.quickSuggestions": {
      "strings": true
    }
  }
}